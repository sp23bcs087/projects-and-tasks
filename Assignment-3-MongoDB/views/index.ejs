<%- include('partials/head', {title: 'BeAnimals - Shop Premium Products' }) %>
    <link rel="stylesheet" href="/products-styles.css">
    <%- include('partials/header') %>

        <main>
            <section class="hero-slider-container">
                <input type="radio" id="slide1" name="hero-slider" checked>
                <input type="radio" id="slide2" name="hero-slider">
                <div class="slides">
                    <div class="slide slide-1">
                        <div class="hero-content">
                            <p class="hero-subtext">meet Chappy</p>
                            <h1 class="hero-headline">THE LIFESAVER DOG</h1>
                            <a href="#" class="cta-button">Read the article</a>
                        </div>
                    </div>
                    <div class="slide slide-2">
                        <div class="hero-content">
                            <p class="hero-subtext">meet Maximus</p>
                            <h1 class="hero-headline">A LOYAL FRIEND</h1>
                            <a href="#" class="cta-button">Read the article</a>
                        </div>
                    </div>
                </div>
                <div class="slider-nav-controls">
                    <label for="slide2" class="nav-for-s1 prev"></label><label for="slide2"
                        class="nav-for-s1 next"></label>
                    <label for="slide1" class="nav-for-s2 prev"></label><label for="slide1"
                        class="nav-for-s2 next"></label>
                </div>
            </section>

            <section class="products-section">
                <div class="container">
                    <div class="section-title">
                        <h2>Our Premium Products</h2>
                        <p>Fetch the best for your furry friends from our MongoDB-powered catalog.</p>
                    </div>

                    
                    <form action="/" method="GET" class="filter-bar">
                        <div class="filter-group">
                            <label for="category">Category</label>
                            <select name="category" id="category">
                                <option value="All" <%=currentCategory==='All' ? 'selected' : '' %>>All Categories
                                </option>
                                <option value="Dogs" <%=currentCategory==='Dogs' ? 'selected' : '' %>>Dogs</option>
                                <option value="Cats" <%=currentCategory==='Cats' ? 'selected' : '' %>>Cats</option>
                                <option value="Birds" <%=currentCategory==='Birds' ? 'selected' : '' %>>Birds</option>
                                <option value="Accessories" <%=currentCategory==='Accessories' ? 'selected' : '' %>
                                    >Accessories</option>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label for="minPrice">Min Price ($)</label>
                            <input type="number" name="minPrice" id="minPrice" value="<%= minPrice %>" placeholder="0">
                        </div>
                        <div class="filter-group">
                            <label for="maxPrice">Max Price ($)</label>
                            <input type="number" name="maxPrice" id="maxPrice" value="<%= maxPrice %>"
                                placeholder="999">
                        </div>
                        <button type="submit" class="filter-btn">Apply Filters</button>
                        <a href="/" class="clear-btn">Clear</a>
                    </form>

                    
                    <div class="articles-grid">
                        <% if (products.length> 0) { %>
                            <% products.forEach(product=> { %>
                                <div class="card">
                                    <img src="<%= product.image %>" alt="<%= product.name %>">
                                    <div class="card-content">
                                        <span class="card-category">
                                            <%= product.category %>
                                        </span>
                                        <h3 style="font-size: 20px; margin-bottom: 10px;">
                                            <%= product.name %>
                                        </h3>
                                        <p style="font-size: 14px; color: #666;">
                                            <%= product.description %>
                                        </p>
                                        <div class="card-price">$<%= product.price.toFixed(2) %>
                                        </div>
                                        <a href="/checkout" class="read-more" style="text-align: center;">Add to
                                            Cart</a>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div style="grid-column: 1 / -1; text-align: center; padding: 50px;">
                                            <h3>No products found matching your criteria.</h3>
                                            <a href="/" class="cta-button" style="font-size: 18px;">Browse All
                                                Products</a>
                                        </div>
                                        <% } %>
                    </div>

                    
                    <% if (totalPages> 1) { %>
                        <div class="pagination">
                            <a href="/?page=<%= currentPage - 1 %>&category=<%= currentCategory %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"
                                class="page-link <%= currentPage === 1 ? 'disabled' : '' %>">Previous</a>

                            <% for(let i=1; i <=totalPages; i++) { %>
                                <a href="/?page=<%= i %>&category=<%= currentCategory %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"
                                    class="page-link <%= currentPage === i ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                                <% } %>

                                    <a href="/?page=<%= currentPage + 1 %>&category=<%= currentCategory %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"
                                        class="page-link <%= currentPage === totalPages ? 'disabled' : '' %>">Next</a>
                        </div>
                        <% } %>
                </div>
            </section>

            <section class="info-section gray-bg">
                <div class="container info-container">
                    <div class="info-text">
                        <h2>What's interesting about <span class="highlight">cats</span></h2>
                        <div class="info-columns">
                            <div>
                                <h5>Independent Nature</h5>
                                <p>Cats are known for their self-sufficiency, but they also form strong bonds with their
                                    owners. <a href="#">More</a></p>
                            </div>
                            <div>
                                <h5>Natural Hunters</h5>
                                <p>Their instincts make them skilled predators, a trait seen even in domesticated cats
                                    during playtime. <a href="#">More</a></p>
                            </div>
                        </div>
                        <div>
                            <h5>Communication Methods</h5>
                            <p>Cats communicate through a variety of vocalizations, body language, and chemical signals.
                                <a href="#">More</a>
                            </p>
                        </div>
                    </div>
                    <div class="info-image"><img src="/assets/home_animals_cat_with_frame.jpg"
                            alt="A cute grey kitten sitting inside an orange frame."></div>
                </div>
            </section>

            
            <section class="info-section">
                <div class="container info-container reverse">
                    <div class="info-text">
                        <h2>What's interesting about <span class="highlight">dogs</span></h2>
                        <div class="info-columns">
                            <div>
                                <h5>Unwavering Loyalty</h5>
                                <p>Dogs are pack animals, which is why they often form incredibly strong and loyal bonds
                                    with their human families. <a href="#">More</a></p>
                            </div>
                            <div>
                                <h5>Diverse Breeds</h5>
                                <p>From the tiny Chihuahua to the giant Great Dane, the diversity among dog breeds is
                                    astounding. <a href="#">More</a></p>
                            </div>
                        </div>
                        <div>
                            <h5>Trainability</h5>
                            <p>Their intelligence and eagerness to please make dogs highly trainable for various tasks
                                and companionship. <a href="#">More</a></p>
                        </div>
                    </div>
                    <div class="info-image"><img src="/assets/home_animals_dog_in_frame.jpg"
                            alt="A dog inside an orange frame."></div>
                </div>
            </section>

            <section class="pupils-section gray-bg">
                <div class="container">
                    <div class="section-title">
                        <h2>Your pupils' photos</h2>
                        <p>A collection of photos sent in by our wonderful community.</p>
                    </div>
                    <div class="gallery-grid">
                        <a href="#img1" class="gallery-item"><img src="/assets/flex_box_dog.jpg"
                                alt="Golden retriever."></a>
                        <a href="#img2" class="gallery-item"><img src="/assets/flex_box_dog2.jpg" alt="Cockapoo."></a>
                        <a href="#img3" class="gallery-item"><img src="/assets/flex_box_cat1.jpg"
                                alt="Cat on a branch."></a>
                        <a href="#img4" class="gallery-item"><img src="/assets/flex_box_cat2.jpg" alt="Grey cat."></a>
                        <a href="#img5" class="gallery-item"><img src="/assets/flex_box_dog3.jpg"
                                alt="Black labrador."></a>
                        <a href="#img6" class="gallery-item"><img src="/assets/flex_box_cat3.jpg"
                                alt="Sleeping cat."></a>
                    </div>
                </div>
            </section>

            <section class="testimonials-section">
                <div class="container">
                    <div class="section-title">
                        <h2>Customer Testimonials</h2>
                    </div>
                    <input type="checkbox" id="view-more-toggle" class="view-more-checkbox">
                    <div class="testimonials-grid">
                        <div class="testimonial-card">
                            <img src="/assets/flex_box_cat2.jpg" alt="Profile of ali" class="testimonial-img">
                            <div class="testimonial-rating">★★★★★</div>
                            <blockquote class="testimonial-text">
                                <p>"The quality of the pet food is amazing! My dog has never been healthier or happier."
                                </p>
                            </blockquote>
                            <cite class="testimonial-author">- ahmad</cite>
                        </div>
                        <div class="testimonial-card">
                            <img src="/assets/flex_box_dog2.jpg" alt="Profile of ahmad" class="testimonial-img">
                            <div class="testimonial-rating">★★★★☆</div>
                            <blockquote class="testimonial-text">
                                <p>"Great selection of toys and accessories."</p>
                            </blockquote>
                            <cite class="testimonial-author">- ali</cite>
                        </div>
                        <div class="testimonial-card">
                            <img src="/assets/flex_box_cat1.jpg" alt="Profile of rizwan" class="testimonial-img">
                            <div class="testimonial-rating">★★★★★</div>
                            <blockquote class="testimonial-text">
                                <p>"Excellent customer service. They helped me choose the perfect bed for my senior
                                    dog."</p>
                            </blockquote>
                            <cite class="testimonial-author">- rizwan</cite>
                        </div>
                        <div class="testimonial-card">
                            <img src="/assets/flex_box_dog.jpg" alt="Profile of mahnoor" class="testimonial-img">
                            <div class="testimonial-rating">★★★★★</div>
                            <blockquote class="testimonial-text">
                                <p>"I've been a loyal customer for years. The prices are fair."</p>
                            </blockquote>
                            <cite class="testimonial-author">- mahnoor</cite>
                        </div>
                    </div>
                    <label for="view-more-toggle" class="view-more-btn">
                        <span class="view-more-text">View More</span>
                        <span class="view-less-text">View Less</span>
                    </label>
                </div>
            </section>
        </main>

        
        <div class="lightbox" id="img1">
            <div class="lightbox-content"><a href="#" class="close">×</a><img src="/assets/flex_box_dog.jpg"
                    alt="Golden retriever."><a href="#img6" class="prev">‹</a><a href="#img2" class="next">›</a><span
                    class="lightbox-counter">1/6</span></div>
        </div>
        <div class="lightbox" id="img2">
            <div class="lightbox-content"><a href="#" class="close">×</a><img src="/assets/flex_box_dog2.jpg"
                    alt="Cockapoo."><a href="#img1" class="prev">‹</a><a href="#img3" class="next">›</a><span
                    class="lightbox-counter">2/6</span></div>
        </div>
        <div class="lightbox" id="img3">
            <div class="lightbox-content"><a href="#" class="close">×</a><img src="/assets/flex_box_cat1.jpg"
                    alt="Cat on a branch."><a href="#img2" class="prev">‹</a><a href="#img4" class="next">›</a><span
                    class="lightbox-counter">3/6</span></div>
        </div>
        <div class="lightbox" id="img4">
            <div class="lightbox-content"><a href="#" class="close">×</a><img src="/assets/flex_box_cat2.jpg"
                    alt="Grey cat."><a href="#img3" class="prev">‹</a><a href="#img5" class="next">›</a><span
                    class="lightbox-counter">4/6</span></div>
        </div>
        <div class="lightbox" id="img5">
            <div class="lightbox-content"><a href="#" class="close">×</a><img src="/assets/flex_box_dog3.jpg"
                    alt="Black labrador."><a href="#img4" class="prev">‹</a><a href="#img6" class="next">›</a><span
                    class="lightbox-counter">5/6</span></div>
        </div>
        <div class="lightbox" id="img6">
            <div class="lightbox-content"><a href="#" class="close">×</a><img src="/assets/flex_box_cat3.jpg"
                    alt="Sleeping cat."><a href="#img5" class="prev">‹</a><a href="#img1" class="next">›</a><span
                    class="lightbox-counter">6/6</span></div>
        </div>

        <%- include('partials/footer') %>
