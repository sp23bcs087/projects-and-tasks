</main>
</div>
<script>
    // Simple client-side confirm for deletes
    document.querySelectorAll('.delete-confirm').forEach(link => {
        link.addEventListener('click', function (e) {
            if (!confirm('Are you sure you want to delete this product?')) {
                e.preventDefault();
            }
        });
    });
</script>
