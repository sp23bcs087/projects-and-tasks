<%- include('partials/head', {title: 'Order Preview' }) %>
    <link rel="stylesheet" href="/products-styles.css">
    <%- include('partials/header') %>

        <main class="container" style="padding-top: 50px; padding-bottom: 50px;">
            <h1 style="margin-bottom: 30px;">Order Preview</h1>

            <div style="background: #f9f9f9; padding: 30px; border-radius: 8px; margin-bottom: 30px;">
                <h3 style="margin-bottom: 20px;">Review Your Items</h3>
                <form action="/order/preview" method="GET"
                    style="margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                    <input type="text" name="coupon" placeholder="Enter SAVE10" value="<%= couponCode || '' %>"
                        style="padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                    <button type="submit" class="cta-button"
                        style="padding: 10px 20px; font-size: 0.9rem; border: none; cursor: pointer;">Apply</button>
                    <% if (couponCode==='SAVE10' ) { %>
                        <span style="color: #4CAF50; font-weight: bold;">✓ Coupon Applied</span>
                        <% } else if (couponCode) { %>
                            <span style="color: #f44336;">Invalid Coupon</span>
                            <% } %>
                </form>

                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid #ddd;">
                            <th style="text-align: left; padding: 10px;">Product</th>
                            <th style="text-align: center; padding: 10px;">Quantity</th>
                            <th style="text-align: right; padding: 10px;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cart.forEach(item=> { %>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 10px;">
                                    <%= item.title %>
                                </td>
                                <td style="text-align: center; padding: 10px;">
                                    <%= item.quantity %>
                                </td>
                                <td style="text-align: right; padding: 10px;">$<%= (item.price *
                                        item.quantity).toFixed(2) %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                    <tfoot>
                        <% if (discount> 0) { %>
                            <tr>
                                <td colspan="2" style="text-align: right; padding: 10px 10px 5px; color: #666;">Original
                                    Total:</td>
                                <td style="text-align: right; padding: 10px 10px 5px; color: #666;">$<%=
                                        total.toFixed(2) %>
                                </td>
                            </tr>
                            <tr style="color: #FF7D44;">
                                <td colspan="2" style="text-align: right; padding: 5px 10px;">Discount (10%):</td>
                                <td style="text-align: right; padding: 5px 10px;">-$<%= discount.toFixed(2) %>
                                </td>
                            </tr>
                            <tr style="font-size: 1.2rem; font-weight: bold;">
                                <td colspan="2" style="text-align: right; padding: 20px 10px;">Final Total:</td>
                                <td style="text-align: right; padding: 20px 10px;">$<%= finalTotal.toFixed(2) %>
                                </td>
                            </tr>
                            <% } else { %>
                                <tr style="font-size: 1.2rem; font-weight: bold;">
                                    <td colspan="2" style="text-align: right; padding: 20px 10px;">Grand Total:</td>
                                    <td style="text-align: right; padding: 20px 10px;">$<%= total.toFixed(2) %>
                                    </td>
                                </tr>
                                <% } %>
                    </tfoot>
                </table>
            </div>

            <div style="display: flex; flex-direction: column; gap: 20px; align-items: flex-end;">
                <form action="/order/confirm" method="POST"
                    style="width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 15px;">
                    <div style="display: flex; flex-direction: column; gap: 5px;">
                        <label for="customerEmail" style="font-weight: bold;">Enter your email to confirm order:</label>
                        <input type="email" name="customerEmail" id="customerEmail" required
                            placeholder="your.email@example.com"
                            style="padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                    </div>
                    <input type="hidden" name="coupon" value="<%= couponCode || '' %>">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
                        <a href="/cart" class="cta-button" style="background-color: #666;">Go Back to Cart</a>
                        <button type="submit" class="cta-button"
                            style="border: none; cursor: pointer; font-size: inherit;">Confirm Order</button>
                    </div>
                </form>
            </div>
        </main>

        <%- include('partials/footer') %>


