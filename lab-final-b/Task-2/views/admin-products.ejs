<%- include('partials/admin-header', {title: 'Manage Products' , activePage: 'products' }) %>

    <div class="admin-card">
        <div class="card-header">
            <h2>All Products</h2>
            <a href="/admin/products/new" class="btn-admin btn-success-admin">
                <i class="fas fa-plus"></i> Add New Product
            </a>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(product=> { %>
                        <tr>
                            <td><img src="<%= product.image %>" alt="" style="height: 40px; border-radius: 4px;"></td>
                            <td><strong>
                                    <%= product.name %>
                                </strong></td>
                            <td><span class="badge badge-<%= product.category %>">
                                    <%= product.category %>
                                </span></td>
                            <td>$<%= product.price.toFixed(2) %>
                            </td>
                            <td class="text-end" style="display: flex; gap: 10px; justify-content: flex-end;">
                                <a href="/admin/products/<%= product._id %>/edit" class="btn-admin btn-primary-admin">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <form action="/admin/products/<%= product._id %>/delete" method="POST"
                                    style="display:inline;">
                                    <button type="submit" class="btn-admin btn-danger-admin delete-confirm">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <%- include('partials/admin-footer') %>



