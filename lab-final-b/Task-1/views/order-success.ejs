<%- include('partials/head', {title: 'Order Success' }) %>
    <link rel="stylesheet" href="/products-styles.css">
    <%- include('partials/header') %>

        <main class="container" style="padding-top: 100px; padding-bottom: 100px; text-align: center;">
            <div
                style="max-width: 600px; margin: 0 auto; background: #fff; padding: 50px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1);">
                <div style="font-size: 4rem; color: #4CAF50; margin-bottom: 20px;">✓</div>
                <h1 style="color: #333; margin-bottom: 10px;">Order Placed Successfully!</h1>
                <p style="color: #666; margin-bottom: 30px;">Thank you for your purchase. Your order has been recorded.
                </p>

                <div
                    style="text-align: left; background: #fdfdfd; border: 1px solid #eee; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
                    <p><strong>Order ID:</strong>
                        <%= order._id %>
                    </p>
                    <p><strong>Status:</strong> <span style="color: #FF7D44;">
                            <%= order.status %>
                        </span></p>
                    <p><strong>Total Amount:</strong> $<%= order.totalAmount.toFixed(2) %>
                    </p>
                    <p><strong>Date:</strong>
                        <%= new Date(order.createdAt).toLocaleString() %>
                    </p>
                </div>

                <a href="/" class="cta-button">Back to Home</a>
            </div>
        </main>

        <%- include('partials/footer') %>


